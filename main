#!/usr/bin/env python3
import asyncio
import logging
import signal
from typing import List

from aiogram import Bot, Dispatcher
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    BotCommand,
    LabeledPrice,
    PreCheckoutQuery,
)
from aiogram.enums import ParseMode
from aiogram.filters import Command
from aiogram.client.bot import DefaultBotProperties

# -----------------------
# Конфигурация (inlined)
# -----------------------
# Вставлены ваши значения
TOKEN: str = "8304973464:AAGEcZ5nD2dO3XKgJznyhJs5TUeYqQb83hQ"  # Ваш токен бота
PROVIDER_TOKEN: str = ""  # Токен провайдера платежей (оставьте пустым, если не используете платежи)
DEFAULT_CURRENCY: str = "USD"  # Валюта, например "USD" или "RUB"
PRODUCT_PRICE_AMOUNT: int = 100  # Сумма в минимальных единицах (cents). 100 -> 1.00
PRODUCT_LABEL: str = "Test product"

# Информация о владельце/админе
OWNER_ID: int = 6101005448
OWNER_USERNAME: str = "@dvestl"
ADMINS: List[int] = [OWNER_ID]  # Список admin user_id

# -----------------------
# Логирование
# -----------------------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

if not TOKEN:
    logger.error("TG_BOT_TOKEN не задан. Установите значение TOKEN в файле перед запуском.")
    raise SystemExit("TG_BOT_TOKEN required")

# -----------------------
# Обработчики
# -----------------------
async def start_handler(message: Message) -> None:
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text=f"Купить {PRODUCT_LABEL} ({PRODUCT_PRICE_AMOUNT/100:.2f} {DEFAULT_CURRENCY})",
                callback_data="buy:test"
            )
        ],
    ])
    await message.answer(
        "<b>Привет!</b>\n\n"
        "Это рабочий бот на aiogram v3.\n"
        "Нажмите кнопку, чтобы получить инвойс (тестовый платёж).\n\n"
        "Команды: /start /pay /help /owner",
        parse_mode=ParseMode.HTML,
        reply_markup=kb,
    )


async def help_handler(message: Message) -> None:
    await message.answer("Помощь:\n/start — старт\n/pay — отправить инвойс\n/help — эта справка\n/owner — информация о владельце")


async def pay_command_handler(message: Message) -> None:
    prices = [LabeledPrice(label=PRODUCT_LABEL, amount=PRODUCT_PRICE_AMOUNT)]
    try:
        await message.bot.send_invoice(
            chat_id=message.chat.id,
            title=PRODUCT_LABEL,
            description="Описание тестового товара",
            payload=f"payload:{message.from_user.id}",
            provider_token=PROVIDER_TOKEN,
            currency=DEFAULT_CURRENCY,
            prices=prices,
        )
    except Exception as exc:
        logger.exception("Failed to send invoice: %s", exc)
        await message.answer("Не удалось отправить инвойс. Проверьте PROVIDER_TOKEN и настройки платежей.")


async def callback_buy_handler(callback: CallbackQuery) -> None:
    await callback.answer()
    prices = [LabeledPrice(label=PRODUCT_LABEL, amount=PRODUCT_PRICE_AMOUNT)]
    try:
        await callback.message.bot.send_invoice(
            chat_id=callback.message.chat.id,
            title=PRODUCT_LABEL,
            description="Оплата через Inline-кнопку",
            payload=f"payload_cb:{callback.from_user.id}",
            provider_token=PROVIDER_TOKEN,
            currency=DEFAULT_CURRENCY,
            prices=prices,
        )
    except Exception as exc:
        logger.exception("send_invoice failed: %s", exc)
        await callback.message.answer("Не удалось открыть платёж. Проверьте настройки.")


async def pre_checkout_query_handler(pre_checkout: PreCheckoutQuery) -> None:
    try:
        await pre_checkout.answer(ok=True)
    except Exception:
        logger.exception("Failed to answer pre_checkout")


async def successful_payment_handler(message: Message) -> None:
    payment = getattr(message, "successful_payment", None)
    if payment:
        await message.answer(
            "Платёж успешно выполнен!\n\n"
            f"Сумма: {payment.total_amount / 100:.2f} {payment.currency}\n"
            f"Payload: {payment.invoice_payload}"
        )
        logger.info("Payment successful: %s", payment)


async def owner_handler(message: Message) -> None:
    await message.answer(f"Владелец бота: {OWNER_USERNAME} (id: {OWNER_ID})")


async def admin_only_handler(message: Message) -> None:
    user_id = message.from_user.id
    if user_id not in ADMINS:
        await message.answer("У вас нет доступа к этой команде.")
        return
    await message.answer("Команда доступна админам.")


# -----------------------
# Запуск бота
# -----------------------
async def main() -> None:
    # Используем DefaultBotProperties для совместимости с aiogram 3.7+
    bot = Bot(token=TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dp = Dispatcher()

    # Регистрируем обработчики
    dp.message.register(start_handler, Command(commands=["start"]))
    dp.message.register(help_handler, Command(commands=["help"]))
    dp.message.register(pay_command_handler, Command(commands=["pay"]))
    dp.message.register(owner_handler, Command(commands=["owner"]))
    dp.callback_query.register(callback_buy_handler, lambda c: c.data and c.data.startswith("buy:"))
    dp.pre_checkout_query.register(pre_checkout_query_handler)
    dp.message.register(successful_payment_handler, lambda m: getattr(m, "successful_payment", None) is not None)
    dp.message.register(admin_only_handler, Command(commands=["admin"]))

    # Устанавливаем команды бота
    try:
        await bot.set_my_commands([
            BotCommand(command="start", description="Start bot"),
            BotCommand(command="pay", description="Get invoice"),
            BotCommand(command="help", description="Help"),
            BotCommand(command="owner", description="Owner info"),
            BotCommand(command="admin", description="Admin only command"),
        ])
    except Exception:
        logger.exception("Не удалось установить команды бота")

    # Graceful shutdown setup
    stop_event = asyncio.Event()

    def _signal_handler(*_) -> None:
        stop_event.set()

    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, _signal_handler)
        except NotImplementedError:
            pass

    polling_task = asyncio.create_task(dp.start_polling(bot))

    await stop_event.wait()
    logger.info("Shutdown signal received, stopping polling...")
    polling_task.cancel()
    try:
        await polling_task
    except asyncio.CancelledError:
        pass
    finally:
        await bot.session.close()
        logger.info("Bot session closed")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Exit")
