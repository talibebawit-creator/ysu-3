#!/usr/bin/env python3
import asyncio
import logging
import signal
import os
from typing import List
from dotenv import load_dotenv

from aiogram import Bot, Dispatcher
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    BotCommand,
    LabeledPrice,
    PreCheckoutQuery,
)
from aiogram.enums import ParseMode
from aiogram.filters import Command
from aiogram.client.bot import DefaultBotProperties
from aiogram.exceptions import TelegramBadRequest

load_dotenv()

# -----------------------
# Конфигурация (из окружения)
# -----------------------
BOT_TOKEN: str = os.getenv("BOT_TOKEN")
PROVIDER_TOKEN: str = os.getenv("PROVIDER_TOKEN", "")
DEFAULT_CURRENCY: str = os.getenv("DEFAULT_CURRENCY", "USD")
try:
    PRODUCT_PRICE_AMOUNT: int = int(os.getenv("PRODUCT_PRICE_AMOUNT", "100"))
except ValueError:
    PRODUCT_PRICE_AMOUNT = 100
PRODUCT_LABEL: str = os.getenv("PRODUCT_LABEL", "Test product")

# Информация о владельце/админе (можно указать несколько id через запятую)
OWNER_ID_ENV = os.getenv("OWNER_ID")
if OWNER_ID_ENV:
    try:
        OWNER_ID = int(OWNER_ID_ENV)
    except ValueError:
        OWNER_ID = None
else:
    OWNER_ID = None
OWNER_USERNAME: str = os.getenv("OWNER_USERNAME", "@owner")
ADMINS_ENV = os.getenv("ADMINS", "")
ADMINS: List[int] = []
if ADMINS_ENV:
    for part in ADMINS_ENV.split(","):
        part = part.strip()
        if not part:
            continue
        try:
            ADMINS.append(int(part))
        except ValueError:
            pass
# ensure owner in admins
if OWNER_ID and OWNER_ID not in ADMINS:
    ADMINS.append(OWNER_ID)

# -----------------------
# Логирование
# -----------------------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

if not BOT_TOKEN:
    logger.error("BOT_TOKEN не задан. Создайте файл .env и добавьте BOT_TOKEN=...")
    raise SystemExit("BOT_TOKEN required")

# Runtime flag: disable payments if provider invalid to avoid spam errors
payments_enabled = True

# -----------------------
# Обработчики
# -----------------------
async def start_handler(message: Message) -> None:
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text=f"Купить {PRODUCT_LABEL} ({PRODUCT_PRICE_AMOUNT/100:.2f} {DEFAULT_CURRENCY})",
                callback_data="buy:test"
            )
        ],
    ])
    # Используем default parse mode на уровне бота, но можно указать здесь при необходимости
    await message.answer(
        "<b>Привет!</b>\n\n"
        "Это рабочий бот на aiogram v3.\n"
        "Нажмите кнопку, чтобы получить инвойс (тестовый платёж).\n\n"
        "Команды: /start /pay /help /owner",
        reply_markup=kb,
    )


async def help_handler(message: Message) -> None:
    await message.answer("Помощь:\n/start — старт\n/pay — отправить инвойс\n/help — эта справка\n/owner — информация о владельце")


async def pay_command_handler(message: Message) -> None:
    global payments_enabled
    if not PROVIDER_TOKEN or not payments_enabled:
        await message.answer("Платежи временно недоступны. Свяжитесь с администратором.")
        return
    prices = [LabeledPrice(label=PRODUCT_LABEL, amount=PRODUCT_PRICE_AMOUNT)]
    try:
        await message.bot.send_invoice(
            chat_id=message.chat.id,
            title=PRODUCT_LABEL,
            description="Описание тестового товара",
            payload=f"payload:{message.from_user.id}",
            provider_token=PROVIDER_TOKEN,
            currency=DEFAULT_CURRENCY,
            prices=prices,
        )
    except TelegramBadRequest as exc:
        logger.exception("Failed to send invoice: %s", exc)
        msg = str(exc)
        # If provider token is invalid, disable payments to avoid repeated errors
        if "PAYMENT_PROVIDER_INVALID" in msg.upper():
            payments_enabled = False
            # notify owner/admin if configured
            notify_text = (
                "[Auto] Ошибка платежного провайдера: PAYMENT_PROVIDER_INVALID.\n"
                "Проверьте PROVIDER_TOKEN в .env и настройки в BotFather.\n"
                f"Ошибка: {msg}"
            )
            if OWNER_ID:
                try:
                    await message.bot.send_message(OWNER_ID, notify_text)
                except Exception:
                    logger.exception("Failed to notify owner about invalid payment provider")
            await message.answer("Ошибка платежного провайдера. Администратор уведомлён, платежи отключены.")
            return
        # other TelegramBadRequest
        await message.answer("Не удалось отправить инвойс. Попробуйте позже.")
    except Exception:
        logger.exception("Unexpected error when sending invoice")
        await message.answer("Внутренняя ошибка при формировании инвойса.")


async def callback_buy_handler(callback: CallbackQuery) -> None:
    global payments_enabled
    await callback.answer()
    if not PROVIDER_TOKEN or not payments_enabled:
        await callback.message.answer("Платежи временно недоступны. Свяжитесь с администратором.")
        return
    prices = [LabeledPrice(label=PRODUCT_LABEL, amount=PRODUCT_PRICE_AMOUNT)]
    try:
        await callback.message.bot.send_invoice(
            chat_id=callback.message.chat.id,
            title=PRODUCT_LABEL,
            description="Оплата через Inline-кнопку",
            payload=f"payload_cb:{callback.from_user.id}",
            provider_token=PROVIDER_TOKEN,
            currency=DEFAULT_CURRENCY,
            prices=prices,
        )
    except TelegramBadRequest as exc:
        logger.exception("send_invoice failed: %s", exc)
        msg = str(exc)
        if "PAYMENT_PROVIDER_INVALID" in msg.upper():
            payments_enabled = False
            notify_text = (
                "[Auto] Ошибка платежного провайдера: PAYMENT_PROVIDER_INVALID.\n"
                "Проверьте PROVIDER_TOKEN в .env и настройки в BotFather.\n"
                f"Ошибка: {msg}"
            )
            if OWNER_ID:
                try:
                    await callback.message.bot.send_message(OWNER_ID, notify_text)
                except Exception:
                    logger.exception("Failed to notify owner about invalid payment provider")
            await callback.message.answer("Ошибка платежного провайдера. Администратор уведомлён, платежи отключены.")
            return
        await callback.message.answer("Не удалось открыть платёж. Попробуйте позже.")
    except Exception:
        logger.exception("Unexpected error when sending invoice via callback")
        await callback.message.answer("Внутренняя ошибка при открытии платежа.")


async def pre_checkout_query_handler(pre_checkout: PreCheckoutQuery) -> None:
    try:
        await pre_checkout.answer(ok=True)
    except Exception:
        logger.exception("Failed to answer pre_checkout")


async def successful_payment_handler(message: Message) -> None:
    payment = getattr(message, "successful_payment", None)
    if payment:
        await message.answer(
            "Платёж успешно выполнен!\n\n"
            f"Сумма: {payment.total_amount / 100:.2f} {payment.currency}\n"
            f"Payload: {payment.invoice_payload}"
        )
        logger.info("Payment successful: %s", payment)


async def owner_handler(message: Message) -> None:
    owner_info = f"{OWNER_USERNAME} (id: {OWNER_ID})" if OWNER_ID else OWNER_USERNAME
    await message.answer(f"Владелец бота: {owner_info}")


async def admin_only_handler(message: Message) -> None:
    user_id = message.from_user.id
    if user_id not in ADMINS:
        await message.answer("У вас нет доступа к этой команде.")
        return
    await message.answer("Команда доступна админам.")


# -----------------------
# Запуск бота
# -----------------------
async def main() -> None:
    # Используем DefaultBotProperties для совместимости с aiogram 3.7+
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dp = Dispatcher()

    # Регистрируем обработчики
    dp.message.register(start_handler, Command(commands=["start"]))
    dp.message.register(help_handler, Command(commands=["help"]))
    dp.message.register(pay_command_handler, Command(commands=["pay"]))
    dp.message.register(owner_handler, Command(commands=["owner"]))
    dp.callback_query.register(callback_buy_handler, lambda c: c.data and c.data.startswith("buy:"))
    dp.pre_checkout_query.register(pre_checkout_query_handler)
    dp.message.register(successful_payment_handler, lambda m: getattr(m, "successful_payment", None) is not None)
    dp.message.register(admin_only_handler, Command(commands=["admin"]))

    # Устанавливаем команды бота
    try:
        await bot.set_my_commands([
            BotCommand(command="start", description="Start bot"),
            BotCommand(command="pay", description="Get invoice"),
            BotCommand(command="help", description="Help"),
            BotCommand(command="owner", description="Owner info"),
            BotCommand(command="admin", description="Admin only command"),
        ])
    except Exception:
        logger.exception("Не удалось установить команды бота")

    # Graceful shutdown setup
    stop_event = asyncio.Event()

    def _signal_handler(*_) -> None:
        stop_event.set()

    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, _signal_handler)
        except NotImplementedError:
            pass

    polling_task = asyncio.create_task(dp.start_polling(bot))

    await stop_event.wait()
    logger.info("Shutdown signal received, stopping polling...")
    polling_task.cancel()
    try:
        await polling_task
    except asyncio.CancelledError:
        pass
    finally:
        await bot.session.close()
        logger.info("Bot session closed")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Exit")
